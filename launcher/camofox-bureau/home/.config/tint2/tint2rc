# Barre du bureau de l'agent, aux couleurs de Noah : lanceurs, fenêtres ouvertes, heure.
# 1 : barre
rounded = 0
border_width = 0
background_color = #11171e 100
border_color = #2a3542 100
# 2 : fenêtre ouverte
rounded = 8
border_width = 0
background_color = #1d2630 100
border_color = #1d2630 100
background_color_hover = #2a3542 100
border_color_hover = #2a3542 100
# 3 : fenêtre active, liseré corail du logo
rounded = 8
border_width = 1
background_color = #2a3542 100
border_color = #ff7a59 100

panel_items = LTC
panel_size = 100% 40
panel_margin = 0 0
panel_padding = 8 4 8
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
wm_menu = 1
panel_dock = 0
# Sans réserve d'écran : Openbox garde la taille de la fenêtre de Camoufox, donc son empreinte (voir bureau/index.js).
strut_policy = none
panel_window_name = tint2
disable_transparency = 1
mouse_effects = 1

taskbar_mode = single_desktop
taskbar_padding = 4 0 6
taskbar_name = 0
taskbar_hide_if_empty = 0
task_icon = 1
task_text = 1
task_maximum_size = 220 32
task_centered = 0
task_padding = 8 2 6
task_font = Sans 10
task_font_color = #e6ebf0 90
task_active_font_color = #ffffff 100
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 3
task_iconified_background_id = 2
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = close

launcher_padding = 4 0 8
launcher_background_id = 0
launcher_icon_size = 26
launcher_tooltip = 1
launcher_item_app = /home/bureau/.local/share/applications/noah-fichiers.desktop
launcher_item_app = /home/bureau/.local/share/applications/noah-editeur.desktop

time1_format = %H:%M
time1_font = Sans Bold 11
time2_format = %d/%m/%Y
time2_font = Sans 8
clock_font_color = #e6ebf0 100
clock_padding = 8 0
clock_background_id = 0
