# Généré automatiquement par install.sh. Ne pas partager.
# Clé entre le serveur Apollo et le lanceur d'agents (réseau Docker interne uniquement).
LAUNCHER_KEY=change-me
# Clé de chiffrement des secrets stockés par le serveur (clés API des fournisseurs).
APOLLO_SECRET_KEY=change-me
# Port de l'interface web.
APOLLO_PORT=8080
# 127.0.0.1 = cette machine seulement ; 0.0.0.0 = accessible depuis le réseau local (téléphone).
APOLLO_BIND=127.0.0.1
