# Généré automatiquement par install.sh. Ne pas partager.
# Clé partagée entre le serveur Apollo et la gateway Hermes (jamais exposée hors du réseau Docker).
HERMES_API_KEY=change-me
# Clé de chiffrement des secrets stockés par le serveur.
APOLLO_SECRET_KEY=change-me
# Port local de l'interface web.
APOLLO_PORT=8080
