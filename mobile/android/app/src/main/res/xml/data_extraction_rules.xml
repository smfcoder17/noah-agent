<?xml version="1.0" encoding="utf-8"?>
<!-- Rien n'est sauvegardé ni transféré vers un autre téléphone : la session est liée à la clé du Keystore de celui-ci
     (illisible ailleurs). Sur le nouveau téléphone, on relie l'app de nouveau. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
