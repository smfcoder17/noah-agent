{
  "name": "noah-agent-desktop",
  "productName": "Noah Agent",
  "version": "0.1.0",
  "description": "Noah Agent sur ton ordinateur : la fenêtre de l'app, et des dossiers que tu confies à tes agents.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "agent.noah.desktop",
    "productName": "Noah Agent",
    "files": ["main.js", "preload.js", "noah.js", "actions.js", "icon.png"],
    "win": { "target": "nsis", "icon": "icon.png", "signAndEditExecutable": false },
    "mac": { "target": "dmg", "icon": "icon.png" },
    "linux": { "target": "AppImage", "icon": "icon.png" }
  }
}
