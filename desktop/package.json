{
  "name": "noah-agent-desktop",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "SmfCoder",
  "productName": "Noah Agent",
  "version": "0.1.0",
  "description": "Noah Agent sur ton ordinateur : la fenêtre de l'app, et des dossiers que tu confies à tes agents.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12",
    "rcedit": "5.0.2"
  },
  "build": {
    "appId": "agent.noah.desktop",
    "productName": "Noah Agent",
    "files": [
      "main.js",
      "preload.js",
      "noah.js",
      "actions.js",
      "autonomie.js",
      "bandeau.js",
      "config.js",
      "demarrage.js",
      "permissions.js",
      "bandeau.html",
      "bandeau-preload.js",
      "dossiers.js",
      "fichiers.js",
      "setup.html",
      "setup.js",
      "icon.png"
    ],
    "afterPack": "apres-empaquetage.js",
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "signAndEditExecutable": false
    },
    "protocols": [{ "name": "Noah Agent", "schemes": ["noah"] }],
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  }
}
