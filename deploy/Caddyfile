# Noah Agent sur un VPS : HTTPS automatique (Let's Encrypt) pour le domaine de NOAH_DOMAIN.
{$NOAH_DOMAIN} {
	# Compression des pages et des scripts seulement : le flux du chat (text/event-stream) part tel quel, sans attente.
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	# Journal d'accès (qui s'est connecté, d'où) dans le volume de Caddy, tournant. Caddy n'y écrit ni l'en-tête
	# Authorization ni les cookies, et aucun jeton ne passe par l'adresse (les liens d'appairage sont dans le #).
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}

	# Le serveur écrit les réponses de l'agent au fil de l'eau : on les transmet sans tampon.
	reverse_proxy server:8080 {
		flush_interval -1
	}
}
