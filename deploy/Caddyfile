# Noah Agent sur un VPS : HTTPS automatique (Let's Encrypt) pour le domaine de NOAH_DOMAIN.
{$NOAH_DOMAIN} {
	# Compression des pages et des scripts seulement : le flux du chat (text/event-stream) part tel quel, sans attente.
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	# HSTS, CSP et le reste : posés par le serveur (server/noah/exposition.py), ici ils partiraient en double.
	header {
		-Server
	}

	# Journal d'accès (qui s'est connecté, d'où) dans le volume de Caddy, tournant. Caddy n'y écrit ni l'en-tête
	# Authorization ni les cookies. Les liens d'appairage et d'installation sont dans le # ; le chemin d'un aperçu porte son
	# jeton, il n'est pas journalisé ; un ancien lien ?installation=… perd son code, dans l'adresse comme dans le Referer.
	log_skip /api/apercu/*
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			request>uri query {
				delete installation
				delete code
				delete state
			}
			request>headers>Referer delete
		}
	}

	# Le serveur écrit les réponses de l'agent au fil de l'eau : on les transmet sans tampon.
	reverse_proxy server:8080 {
		flush_interval -1
	}
}
